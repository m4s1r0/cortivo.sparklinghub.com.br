{
  "name": "cortivo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cortivo — gestão para barbearias (Sparkling Hub)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "lint": "eslint . && node scripts/check-ui.mjs",
    "format": "prettier --write .",
    "test:unit": "npm run test:unit -w api && npm run test:unit -w web",
    "test:integration": "npm run test:integration -w api",
    "test:contract": "npm run test:contract -w api",
    "test:e2e": "npm run test:e2e -w web",
    "build": "npm run build -w api && npm run build -w web",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript-eslint": "^8.46.0"
  }
}
