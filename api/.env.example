# Cortivo API — exemplo de configuração. Copie para `api/.env` (nunca commitar) e preencha.
# Nenhum valor secreto deve aparecer neste arquivo. Validado no boot por `src/env.ts` (falha cedo).

# development | production | test. Em production: cookie `__Host-` com Secure, TLS nos pools, HSTS.
NODE_ENV=development

# Porta da API (ECO-002). Vite de desenvolvimento usa 5177.
PORT=3003

# Origem pública da aplicação (esquema + host + porta, sem caminho). Usada na verificação de
# origem das escritas (SEC-BASE-05) e para decidir o nome/atributos do cookie. https fora do dev.
PUBLIC_ORIGIN=http://127.0.0.1:5177

# Proxies confiáveis para X-Forwarded-For (SEC-BASE-02): lista separada por vírgula de IPs ou
# CIDR. Vazio = nenhum; o IP do cliente é sempre o do socket.
TRUSTED_PROXIES=

# Segredo da sessão: pelo menos 32 bytes aleatórios (ex.: `openssl rand -base64 48`).
SESSION_SECRET=
# Segredos anteriores aceitos só para decifrar (rotação), separados por vírgula. Vazio = nenhum.
SESSION_SECRET_PREVIOUS=

# Core (SparkCore) — contrato /internal/v1. ECO-002.2: em desenvolvimento, porta 5273.
SPARKCORE_INTERNAL_URL=http://127.0.0.1:5273
# Endereço público da interface do Core; usado só no redirecionamento para /recuperar (FR-030).
SPARKCORE_PUBLIC_URL=http://127.0.0.1:5173
# Credencial de aplicação (escopos connection, sessions, members), vinculada à instância
# (SEC-BASE-01; com o Core 1.4 credencial por produto é recusada). Segredo: nunca em log.
SPARKCORE_APP_CREDENTIAL=
# Slug da instância atendida por este processo (um processo por instância, ECO-012.1).
SPARKCORE_INSTANCE_SLUG=

# Testes de integração: MySQL 8.4 real (porta 3307 do ecossistema) com credencial de teste que
# só cria bancos `t_*`. Nunca aponte para um banco de instância real.
TEST_MYSQL_URL=
# Checkout do SparkCore para os testes de deriva de contrato/artefato (opcional localmente).
CORE_REPO_DIR=
